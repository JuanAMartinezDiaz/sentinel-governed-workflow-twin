{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanmartinez.ai/schemas/sentinel-safety-monitoring-1.0.schema.json",
  "title": "Sentinel Safety Monitoring Companion - Synthetic Design Review v1",
  "$defs": {
    "optionalReference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "specification_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "const": "synthetic_design_review"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "agent_identity_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "policy_version_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "source_requirements_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "allowed_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "data_scope_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "reviewer_role_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "requirements_confirmation_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "response_owner_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "backup_owner_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "response_deadline_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 604800
          },
          "recovery_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "retention_access_ref": {
            "$ref": "#/$defs/optionalReference"
          },
          "controls": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "goal_id": {
                  "enum": [
                    "SMG-01",
                    "SMG-02",
                    "SMG-03",
                    "SMG-04",
                    "SMG-05",
                    "SMG-06"
                  ]
                },
                "mandatory": {
                  "const": true
                },
                "status": {
                  "enum": [
                    "missing",
                    "specified",
                    "instrumented",
                    "verified",
                    "failed",
                    "not_applicable"
                  ]
                },
                "required_events": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "uniqueItems": true
                },
                "event_producer_ref": {
                  "$ref": "#/$defs/optionalReference"
                },
                "detection_rule_ref": {
                  "$ref": "#/$defs/optionalReference"
                },
                "response": {
                  "enum": [
                    "BLOCK_OR_PAUSE"
                  ]
                },
                "test_ids": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "SM-01",
                      "SM-02",
                      "SM-03",
                      "SM-04",
                      "SM-05",
                      "SM-06",
                      "SM-07",
                      "SM-08"
                    ]
                  },
                  "uniqueItems": true
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "uniqueItems": true
                },
                "verification": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "artifact_ref": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "candidate_revision": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "configuration_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "checked_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "reviewer_ref": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "artifact_ref",
                        "candidate_revision",
                        "configuration_sha256",
                        "checked_at",
                        "reviewer_ref"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "not_applicable_justification": {
                  "$ref": "#/$defs/optionalReference"
                },
                "disabled_capability_evidence_ref": {
                  "$ref": "#/$defs/optionalReference"
                }
              },
              "required": [
                "goal_id",
                "mandatory",
                "status",
                "required_events",
                "event_producer_ref",
                "detection_rule_ref",
                "response",
                "test_ids",
                "evidence_refs",
                "verification",
                "not_applicable_justification",
                "disabled_capability_evidence_ref"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "not_applicable"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "not_applicable_justification": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "disabled_capability_evidence_ref": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "verified"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "verification": {
                        "type": "object",
                        "properties": {
                          "artifact_ref": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "candidate_revision": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "configuration_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "checked_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "reviewer_ref": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        },
                        "required": [
                          "artifact_ref",
                          "candidate_revision",
                          "configuration_sha256",
                          "checked_at",
                          "reviewer_ref"
                        ],
                        "additionalProperties": false
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "uniqueItems": true,
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "step_id",
          "owner_ref",
          "agent_identity_ref",
          "policy_version_ref",
          "source_requirements_ref",
          "allowed_tools",
          "data_scope_ref",
          "reviewer_role_ref",
          "requirements_confirmation_ref",
          "response_owner_ref",
          "backup_owner_ref",
          "response_deadline_seconds",
          "recovery_ref",
          "retention_access_ref",
          "controls"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "specification_version",
    "workflow_id",
    "workflow_version",
    "workflow_sha256",
    "scope",
    "steps"
  ],
  "additionalProperties": false
}
